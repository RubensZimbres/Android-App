<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/fire_orange</item>
        <item name="colorPrimaryDark">@color/bg_dark</item>
        <item name="colorAccent">@color/fire_amber</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Large rounded pill buttons -->
    <style name="PillButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">60dp</item>
        <item name="android:minWidth">200dp</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="PillButton.Primary">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/bg_dark</item>
    </style>

    <style name="PillButton.Outline">
        <item name="android:background">@drawable/button_outline</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="ScoreValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="ScoreLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
